#include <iostream>
#include <queue>
using namespace std;

int main() {
    queue<int> orders;
    int orderNumber;

    // Store 5 customer order numbers
    cout << "Enter 5 customer order numbers:\n";

    for (int i = 0; i < 5; i++) {
        cin >> orderNumber;
        orders.push(orderNumber);
    }

    // Display the queue
    cout << "\nCustomer Order Numbers:\n";

    while (!orders.empty()) {
        cout << orders.front() << " ";
        orders.pop();
    }

    return 0;
}
